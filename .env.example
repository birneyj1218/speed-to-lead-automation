# Copy to .env and fill in. Never commit .env.
# Defaults point every provider at the local mock server (npm run mock),
# so the whole flow runs without real accounts.

# ---- Decision service (npm start)
PORT=3030
# 127.0.0.1 for local only; 0.0.0.0 so the n8n container can reach it
HOST=0.0.0.0
CONFIG_PATH=./config/blue-gable-roofing.json
STATE_FILE=./data/state.json
# Optional shared key; n8n sends it as X-Api-Key
DECISION_API_KEY=change-me

# ---- Read by the n8n workflow ($env). Hosts are as seen from inside the n8n container.
DECISION_API_URL=http://host.docker.internal:3030
TWILIO_BASE_URL=http://host.docker.internal:4010
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+13125550100
VAPI_BASE_URL=http://host.docker.internal:4010
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_ASSISTANT_ID_BUSINESS_HOURS=your-business-hours-assistant-id
VAPI_ASSISTANT_ID_AFTER_HOURS=your-after-hours-assistant-id
GHL_BASE_URL=http://host.docker.internal:4010
GHL_LOCATION_ID=your-location-id
CRM_WEBHOOK_URL=http://host.docker.internal:4010/crm/webhook
FB_GRAPH_BASE_URL=http://host.docker.internal:4010/graph
FB_VERIFY_TOKEN=pick-a-random-string
# Real endpoints when you go live:
#   TWILIO_BASE_URL=https://api.twilio.com
#   VAPI_BASE_URL=https://api.vapi.ai
#   GHL_BASE_URL=https://services.leadconnectorhq.com
#   FB_GRAPH_BASE_URL=https://graph.facebook.com/v21.0
# Secrets (Twilio auth token, Vapi key, CRM token, Facebook token) go in
# n8n credentials, not here. See docs/n8n-workflow.md.

# ---- Only for running src/dispatch.js adapters directly (no n8n)
SMS_PROVIDER=memory
VOICE_PROVIDER=memory
CRM_PROVIDER=memory
TWILIO_AUTH_TOKEN=your-twilio-auth-token
VAPI_API_KEY=your-vapi-api-key
GHL_API_KEY=your-crm-token
CRM_WEBHOOK_SECRET=your-signing-secret

# ---- n8n container
N8N_ENCRYPTION_KEY=generate-a-long-random-string
GENERIC_TIMEZONE=America/Chicago
