    {
      "parameters": {
        "jsCode": "// Lead Ads send only a leadgen_id; comments carry the text. Same logic as parseFacebookWebhook() in src/normalize.js.\n// Production: verify X-Hub-Signature-256 against the raw body before trusting this (see docs/n8n-workflow.md).\nconst out = [];\nfor (const item of $input.all()) {\n  for (const entry of item.json.body?.entry ?? []) {\n    for (const change of entry.changes ?? []) {\n      const v = change.value ?? {};\n      if (change.field === 'leadgen') out.push({ json: { kind: 'leadgen', leadgenId: v.leadgen_id } });\n      else if (change.field === 'feed' && v.item === 'comment' && v.verb === 'add') out.push({ json: { kind: 'comment', source: 'facebook_comment', payload: v } });\n    }\n  }\n}\nreturn out;"
      },
