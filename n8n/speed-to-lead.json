        "mode": "runOnceForEachItem",
        "jsCode": "// Pair the provider response with the action that caused it (n8n keeps item pairing through the HTTP node).\nconst action = $('SMS or call?').item.json;\nconst failed = Boolean($json.error);\nreturn {\n  json: {\n    stepId: action.stepId,\n    ok: !failed,\n    providerId: $json.sid ?? $json.id ?? null,\n    error: failed ? JSON.stringify($json.error).slice(0, 300) : null,\n  },\n};"
      },
